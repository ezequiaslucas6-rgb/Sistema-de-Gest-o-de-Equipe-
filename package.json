{
  "name": "escala-tecnica",
  "productName": "Escala Técnica",
  "private": true,
  "version": "1.11.0",
  "description": "Escala Técnica — gestão das duplas de Suporte Técnico e Infraestrutura Backbone (6x1/5x2, plantões, feriados, banco de horas)",
  "author": "Ezequias",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win --publish never"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@capacitor/push-notifications": "8.1.3",
    "exceljs": "4.4.0",
    "jspdf": "2.5.2",
    "pdfjs-dist": "4.10.38",
    "sql.js": "1.13.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-switch": "1.4.1",
    "@radix-ui/react-toggle": "1.2.1",
    "@radix-ui/react-toggle-group": "1.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@supabase/supabase-js": "2.118.0",
    "@tanstack/react-query": "5.104.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "electron": "37.10.3",
    "electron-builder": "26.0.12",
    "lucide-react": "0.577.0",
    "react": "19.3.1",
    "react-day-picker": "9.14.0",
    "react-dom": "19.3.1",
    "react-router-dom": "6.30.6",
    "typescript": "5.9.3",
    "vite": "6.4.5",
    "zod": "3.25.76"
  },
  "build": {
    "appId": "br.com.escalatecnica.app",
    "productName": "Escala Técnica",
    "copyright": "Escala Técnica",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Escala Técnica",
      "runAfterFinish": true,
      "artifactName": "Escala-Tecnica-Instalador-${version}.${ext}",
      "uninstallDisplayName": "Escala Técnica"
    },
    "portable": {
      "artifactName": "Escala-Tecnica-Portatil-${version}.${ext}"
    }
  },
  "escala": {
    "androidMinBuild": 0
  }
}
